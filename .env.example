# Dashboard
PORT=4321

# Capture cadence (seconds) at startup.
# Can be changed live from the dashboard dropdown (1, 2, 5, 10 or 15 minutes).
INTERVAL_SECONDS=60

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:latest
OLLAMA_TIMEOUT_SECONDS=240
OLLAMA_TEMPERATURE=0.3
# Stream the model's reasoning trace to the dashboard's live panel. Only reasoning models
# (qwen3, deepseek-r1, gpt-oss…) support this; on others the request is retried without it
# and the panel streams the answer being written instead.
OLLAMA_THINK=false
# Model stays in memory this long during market hours; unloads immediately outside them.
OLLAMA_KEEP_ALIVE=5m
OLLAMA_IDLE_KEEP_ALIVE=0

# Live NIFTY 50 quote, fetched with every capture and given to the model as ground truth,
# then used to correct its spot reading afterwards. Turn off with QUOTE_ENABLED=false.
QUOTE_ENABLED=true
# auto = NSE first (exchange's own number), Yahoo as fallback. Or force one: nse | yahoo
QUOTE_SOURCE=auto
QUOTE_TIMEOUT_SECONDS=8
QUOTE_CACHE_SECONDS=5
# Keep serving the last good quote for this long if both providers fail mid-session.
QUOTE_MAX_STALE_SECONDS=300
# How far the model's chart reading may differ from the live feed before it's treated as a
# misread and overwritten (the larger of the two wins).
QUOTE_TOLERANCE_POINTS=25
QUOTE_TOLERANCE_PCT=0.1

# Market window (IST). Captures run ONLY inside this window; outside it the scheduler
# sleeps until the next open and the model is unloaded. Weekends are skipped;
# exchange holidays are not tracked, so pause the schedule by hand on those days.
MARKET_TZ=Asia/Kolkata
MARKET_OPEN=09:15
MARKET_CLOSE=15:15
# Extra minutes either side for keeping the model warm only — does not run captures.
MARKET_MARGIN_MINUTES=5

# Browser
# Do NOT set HEADLESS=true: Zerodha invalidates the session for headless Chrome.
HEADLESS=false
# Tuck the window into the screen corner so it stays out of your way while capturing.
TUCK_WINDOW=true
TUCK_WIDTH=380
TUCK_HEIGHT=260
VIEWPORT_WIDTH=1600
VIEWPORT_HEIGHT=950
# Pixels captured per CSS pixel (1 = plain, 2 = retina, 3 = maximum useful).
# Raise this if the model misreads price levels or OI strike numbers; lower it to 1
# if the browser struggles for memory. Screenshot files grow roughly with the square.
DEVICE_SCALE_FACTOR=2
NAV_TIMEOUT_SECONDS=90
SETTLE_MS=4000
# Kite chart controls, re-applied every cycle.
# KITE_INTERVAL is TradingView's value: 1=1min, 5=5min, 15, 30, 60=1hr, 1D=daily. Empty = leave as-is.
KITE_INTERVAL=1
# Bottom date-range tab: 1d, 5d, 1m, 3m, 6m, 1yr, 5yr, All. Empty = leave as-is.
KITE_RANGE=1d
# Reload both pages every N cycles (0 = never auto-reload)
RELOAD_EVERY_CYCLES=0

# Retention
HISTORY_LIMIT=200
RETAIN_SHOTS=400

# Where the dashboard's "Save snapshots" button writes its PNGs.
# Defaults to ~/Downloads.
# DOWNLOADS_DIR=/Users/you/Downloads

# Portable export
# Every finished run is mirrored into a plain folder the dashboard can import off disk
# (see "Portable export" in the README). Screenshots are hardlinked, so this is free.
ARCHIVE_ENABLED=true
# ARCHIVE_DIR=/Users/you/vision-exports
